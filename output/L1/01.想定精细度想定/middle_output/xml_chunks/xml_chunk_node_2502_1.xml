  <UseGroupSizeHardLimit/>
  <!--TankerMinNumber_Station 中文描述：加油机数量——在驻地-->
  <TankerMinNumber_Station/>
  <!--TankerMissionList 中文描述：任务中的加油机列表-->
  <TankerMissionList/>
