<Sensor xml-id="node_2550_6" parent-id="2492_6,2519_6" node-type="Node" parent-json-key="Sensors" full-json-path="Scenario-&amp;gt;ActiveUnits-&amp;gt;Aircraft[1]-&amp;gt;Sensors-&amp;gt;Sensor[3]">
  <!--生成约束：布尔值。False 表示该传感器不是伪装对象，不用于欺骗性身份表现；True 表示该传感器是伪装对象 | 举例：False-->
  <IsMasquerade/>
  <!--生成约束：布尔值。True 表示该传感器可能支持多基地/多站协同工作，或在系统建模中被标记为多基地能力；False表示不支持 | 举例：True-->
  <IsMultiBaseSensor/>
  <!--生成约束：整数类型。对水下传感器常用于表示部署深度；对飞机/舰艇雷达等通常为 0，表示不涉及水下深度或位于平台基准位置 | 举例：0-->
  <SensorDepth/>
  <!--生成约束：布尔值：False 表示没有人工强制覆盖，传感器由系统自动控制；True 表示人工强制覆盖 | 举例：False-->
  <ManualOverride/>
  <!--St 中文描述：传感器状态 | 生成约束：0：正常工作；1：受到毁伤；2：已被摧毁；如果是正常工作，不写入XML中 | 举例：0-->
  <St/>
  <!--ID 中文描述：传感器ID | 生成约束：随机生成UUID（32 个十六进制数字+4个连字符组成，格式为8-4-4-4-12）-->
  <ID/>
  <!--Name 中文描述：传感器名称 | 举例：铺路爪雷达-->
  <Name/>
  <!--DBGUID 中文描述：传感器数据库ID-->
  <DBGUID/>
  <!--IsA 中文描述：传感器正在工作 | 生成约束：如果没有工作，不写入XML；True 是；；False 否 | 举例：True-->
  <IsA/>
  <!--DamageSeverity 中文描述：毁伤程度 | 生成约束：0：轻度；1：中度；2：重度；如果是轻度毁伤，不写入XML中 | 举例：0-->
  <DamageSeverity/>
</Sensor>